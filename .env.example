# --- Storage (optional for local dev, REQUIRED for production) ---
# In local `npm run dev` the app uses an in-memory store automatically, so you
# can try the full flow with two browser tabs without any setup.
#
# On Vercel (serverless), memory does not persist between requests, so you must
# connect a Redis/KV store. Create one from the Vercel dashboard:
#   Storage -> Create Database -> Upstash for Redis (Marketplace)
# Vercel will auto-inject these env vars. If you set them manually, use either
# the KV_* names (Vercel) or the UPSTASH_* names (Upstash directly).

KV_REST_API_URL=
KV_REST_API_TOKEN=

# Alternatively:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Base URL used when generating invite links (optional; auto-detected on Vercel)
# NEXT_PUBLIC_BASE_URL=https://your-app.vercel.app
